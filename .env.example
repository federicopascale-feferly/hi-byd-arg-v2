# API key de Anthropic para el asistente de consultas (/api/chat).
# Sin esta variable la app funciona igual, pero el chat responde "no configurado".
# En Vercel: vercel env add ANTHROPIC_API_KEY production
ANTHROPIC_API_KEY=

# Token propio para el endpoint de QA externo /api/agente-test (ej: ArtificialQA
# lo usa como Bearer para testear al asistente). Sin esta variable el endpoint
# responde 503 y el resto de la app funciona igual.
# En Vercel: vercel env add AGENTE_TEST_TOKEN production
AGENTE_TEST_TOKEN=
